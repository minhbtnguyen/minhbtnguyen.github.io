---
import { projects } from '../data/projects.js';
const featured = projects.filter((p) => p.featured);
---

<div>
  <!-- Section label -->
  <div class="flex items-center gap-2 mb-4 justify-center lg:justify-start">
    <div class="w-[3px] h-4 bg-[#CC4400]"></div>
    <span class="text-[13px] font-medium tracking-[0.12em] uppercase text-[#888078]">Spare-time Builds</span>
  </div>

  <!-- Featured project cards -->
  <div class="space-y-3">
    {
      featured.map((p) => (
        <div class="project-card group flex flex-col border border-[#E4DDD4] bg-[#FEFCF8] hover:shadow-[0_8px_32px_rgba(0,0,0,0.07)] overflow-hidden p-5">
          <div class="flex items-center justify-between gap-2 mb-2">
            <a
              href={p.demoHref || p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[15px] text-[#CC4400] leading-[1.25] hover:underline decoration-[#CC4400]"
              style="font-family:'DM Serif Display',Georgia,serif;"
            >
              {p.name}
            </a>
            {p.demoHref && (
              <span class="live-dot shrink-0" title="Live demo" aria-label="Live demo"></span>
            )}
          </div>
          <p class="text-[12px] font-light text-[#4A4540] leading-[1.7]">
            {p.description}
          </p>
        </div>
      ))
    }
  </div>

  <!-- Footer note -->
  <p class="mt-4 text-[11px] font-light text-[#888078] italic leading-[1.6] text-center lg:text-left">
    Built nights and weekends. Day-job production work is in Experience.
  </p>
</div>

<style>
  @keyframes borderPulse {
    0%, 100% { border-color: #E4DDD4; }
    50%       { border-color: #CC4400; }
  }

  .project-card {
    animation: borderPulse 3s ease-in-out infinite;
  }

  .project-card:nth-child(2) { animation-delay: 1.5s; }

  .project-card:hover {
    animation: none;
    border-color: #CC4400;
    transition: border-color 0.3s ease;
  }

  .live-dot {
    position: relative;
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background-color: #22C55E;
  }

  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-color: #22C55E;
    animation: liveDotPing 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes liveDotPing {
    0%   { transform: scale(1); opacity: 0.7; }
    75%, 100% { transform: scale(2.5); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot::after {
      animation: none;
    }
  }
</style>
